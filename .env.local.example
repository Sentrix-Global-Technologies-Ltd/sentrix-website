# Copy to .env.local for local development (gitignored, Next.js loads it
# automatically). Not needed for production builds — next.config.mjs's
# defaults already point at the real backend (api.sentrixglobaltech.com).

# Point the demo form at a locally running sentrix-backend instead of
# production. Must include the /api/v1 suffix, matching sentrix-backend's
# route prefix.
NEXT_PUBLIC_API_BASE_URL=http://localhost/api/v1
